+        scene_root = os.path.dirname(images_folder)
+        depth_mono_path = os.path.join(scene_root, 'depth_maps', 'depth_' + image_name + '.png')
+
+        if os.path.exists(depth_mono_path):
+            depth_mono = Image.open(depth_mono_path)
+        else:
+            # 如果深度图不存在，打印警告并设为 None，防止程序崩溃
