+			std::clock_t End = clock();
+
+			std::printf("glm::log2<vec4>: %d clocks\n", static_cast<int>(End - Begin));
+		}
+
+		return Error;
+	}
+}//namespace log2_
+
+namespace iround
+{
+	int test()
+	{
