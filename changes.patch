+;------------------------------------------------------------------------------
+;  std::pair from <utility>
+;------------------------------------------------------------------------------
+std::pair<*>{
+	; pair is previewed with "(<first>, <second>)".
+	preview (
+		#(
+			"(",
+			$e.first,
+			", ",
+			$e.second,
+			")"
+		)
+	)
+
+	; We gloss over the fact that first and second are actually stored in _Pair_base.
+	children (
+		#(
+			#(first : $e.first),
+			#(second : $e.second)
+		)
+	)
+}
