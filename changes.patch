+		std::printf("vec3 - Aligned: %d, unaligned: %d\n", static_cast<int>(sizeof(S1)), static_cast<int>(sizeof(S2)));
+
+		Error += sizeof(S1) <= sizeof(S2) ? 0 : 1;
+	}
