diff --git a/submodules/diff-gaussian-rasterization-confidence/third_party/glm/glm/gtx/matrix_transform_2d.inl b/submodules/diff-gaussian-rasterization-confidence/third_party/glm/glm/gtx/matrix_transform_2d.inl
