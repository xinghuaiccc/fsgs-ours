diff --git a/submodules/diff-gaussian-rasterization-confidence/third_party/glm/test/gtc/gtc_epsilon.cpp b/submodules/diff-gaussian-rasterization-confidence/third_party/glm/test/gtc/gtc_epsilon.cpp
