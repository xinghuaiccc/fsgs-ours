diff --git a/submodules/diff-gaussian-rasterization-confidence/third_party/glm/test/gtx/gtx_component_wise.cpp b/submodules/diff-gaussian-rasterization-confidence/third_party/glm/test/gtx/gtx_component_wise.cpp
